#!/bin/sh

NETWORKING=/home/$USER/networking
JIVE=/home/$USER/jive5ab

DISCARD="-x 5"
#DISCARD=""

gnome-terminal --title="jive5ab" --geometry 100x40+100+100 -- $JIVE/vdif_net/vdif_net

sleep 2

gnome-terminal --title="create vdif" --geometry 40x40+300+300 -- $NETWORKING/create_vdif -d 25 $DISCARD -u 300 127.0.0.1 22001



